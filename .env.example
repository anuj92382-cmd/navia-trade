# =================================================================
# Navia Algo Trading Configuration
# =================================================================

# 1. Navia Credentials (from your Navia account dashboard)
NAVIA_CLIENT_CODE=YOUR_CLIENT_UCC
NAVIA_PASSWORD=YOUR_PASSWORD
NAVIA_API_KEY=YOUR_API_KEY_IF_APPLICABLE
NAVIA_AUTH_TOKEN=DEFAULT

# 2. Server Gateways
NAVIA_BASE_URL=https://naviaapt.navia.co.in:9003
NAVIA_WS_URL=wss://naviaapt.navia.co.in:9003/ws

# 3. Trading Mode:
# set true for Simulation (Zero Risk), set false for Real Live Money Trades
PAPER_TRADING=true

# 4. Strategy & Order Defaults
DEFAULT_EXCHANGE=NSE
DEFAULT_SYMBOL=RELIANCE-EQ
DEFAULT_QUANTITY=1
DEFAULT_PRODUCT=MIS

# 5. Risk Controls
STOP_LOSS_PCT=1.0
TAKE_PROFIT_PCT=2.0
MAX_DAILY_LOSS=5000.0
